# =====================================================================
# API Keys Configuration
# Rename this file to `.env` in the root or module directory
# =====================================================================

# Groq API Key (Free tier available, ultra-fast Llama 3 models)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Token (Access open-source models & Inference Endpoints)
# Get yours at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here

# OpenRouter API Key (Unified API for multi-provider LLMs)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Optional, for OpenAI models or embeddings)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here